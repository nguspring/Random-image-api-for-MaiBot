{
  "manifest_version": 2,
  "id": "nguspring.random-image-api-for-maibot",
  "version": "1.2.0",
  "name": "随机图片和色图插件（Random-image-api-for-MaiBot）",
  "description": "从 Random-image-api 拉取 Pixiv 随机图片，支持多地址回退、全局冷却、R18 白名单/黑名单、标签筛选、多图获取、AI 过滤、合并转发、智能压缩、尺寸筛选等功能",
  "author": {
    "name": "NGU-SprinG",
    "url": "https://github.com/nguspring"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/nguspring/Random-image-api-for-MaiBot",
    "homepage": "https://github.com/nguspring/Random-image-api-for-MaiBot",
    "documentation": "https://github.com/nguspring/Random-image-api-for-MaiBot/blob/main/README.md",
    "issues": "https://github.com/nguspring/Random-image-api-for-MaiBot/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.8.2",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "send.custom",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "media"
}
